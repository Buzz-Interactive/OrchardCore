@model ABTestPartViewModel

@switch (Model.Status)
{
    case ABTestStatus.Inactive:
        <span class="badge ta-badge" data-bs-original-title="Status" data-bs-toggle="tooltip"><i class="fa-solid fa-ban text-secondary" aria-hidden="true"></i> @T["Draft"]</span>
        break;
    case ABTestStatus.Running:
        <span class="badge ta-badge" data-bs-original-title="Status" data-bs-toggle="tooltip"><i class="fa-solid fa-play text-success" aria-hidden="true"></i> @T["Running"]</span>
        break;
}

<span class="badge ta-badge" data-bs-original-title="Total Impressions" data-bs-toggle="tooltip"><i class="fa-solid fa-eye text-secondary" aria-hidden="true"></i> @T["{0} Impressions", Model.TotalImpressions]</span>
