@model ABTestPartViewModel

<h5>@T["Traffic Split"]</h5>
<div class="row align-items-center">
    <div class="col-md-8">
        <label asp-for="PercentageA" class="form-label">@T["Variant A Percentage"]</label>
        <input asp-for="PercentageA" type="range" class="form-range" min="0" max="100" id="percentageSlider-@Html.IdFor(m => m)" />
        <span asp-validation-for="PercentageA" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <div class="d-flex justify-content-around">
            <div class="text-center">
                <strong>@T["Variant A"]</strong>
                <div class="fs-4 text-primary" id="percentageADisplay-@Html.IdFor(m => m)">@Model.PercentageA%</div>
            </div>
            <div class="text-center">
                <strong>@T["Variant B"]</strong>
                <div class="fs-4 text-secondary" id="percentageBDisplay-@Html.IdFor(m => m)">@Model.PercentageB%</div>
            </div>
        </div>
    </div>
</div>
<div class="form-text">@T["Drag the slider to adjust the traffic split between variants."]</div>

<script at="Foot">
    (function() {
        var prefix = '@Html.IdFor(m => m)';
        var slider = document.getElementById('percentageSlider-' + prefix);
        var displayA = document.getElementById('percentageADisplay-' + prefix);
        var displayB = document.getElementById('percentageBDisplay-' + prefix);

        slider.addEventListener('input', function() {
            var valueA = parseInt(this.value);
            var valueB = 100 - valueA;
            displayA.textContent = valueA + '%';
            displayB.textContent = valueB + '%';
        });
    })();
</script>
