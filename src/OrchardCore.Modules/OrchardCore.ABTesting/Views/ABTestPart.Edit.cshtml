@model ABTestPartViewModel

<div class="mb-3">
    <h5>@T["Traffic Split"]</h5>
    <div class="row align-items-center">
        <div class="col-md-8">
            <label asp-for="PercentageA" class="form-label">@T["Variant A Percentage"]</label>
            <input asp-for="PercentageA" type="range" class="form-range" min="0" max="100" id="percentageSlider" />
            <span asp-validation-for="PercentageA" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <div class="d-flex justify-content-around">
                <div class="text-center">
                    <strong>@T["Variant A"]</strong>
                    <div class="fs-4 text-primary" id="percentageADisplay">@Model.PercentageA%</div>
                </div>
                <div class="text-center">
                    <strong>@T["Variant B"]</strong>
                    <div class="fs-4 text-secondary" id="percentageBDisplay">@Model.PercentageB%</div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-text">@T["Drag the slider to adjust the traffic split between variants."]</div>
</div>

<div class="mb-3">
    <h5>@T["Schedule (Optional)"]</h5>
    <div class="row">
        <div class="col-md-3">
            <label asp-for="ScheduledStartLocalDateTime" class="form-label">@T["Start Date"]</label>
            <input asp-for="ScheduledStartLocalDateTime" type="datetime-local" class="form-control" />
            <span asp-validation-for="ScheduledStartLocalDateTime" class="text-danger"></span>
            <div class="form-text">@T["Leave empty to start immediately when published."]</div>
        </div>
        <div class="col-md-3">
            <label asp-for="ScheduledEndLocalDateTime" class="form-label">@T["End Date"]</label>
            <input asp-for="ScheduledEndLocalDateTime" type="datetime-local" class="form-control" />
            <span asp-validation-for="ScheduledEndLocalDateTime" class="text-danger"></span>
            <div class="form-text">@T["Leave empty to run indefinitely."]</div>
        </div>
    </div>
</div>

<div class="mb-3">
    <div class="form-check form-switch">
        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
        <label asp-for="IsActive" class="form-check-label">@T["Test is Active"]</label>
    </div>
    <div class="form-text">@T["When inactive, visitors will see the original content without any redirection."]</div>
</div>

<div class="mb-3">
    <h5>@T["Goal Configuration"]</h5>
    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="GoalType" class="form-label">@T["Goal Type"]</label>
            <select asp-for="GoalType" class="form-select" id="goalTypeSelect">
                <option value="0">@T["No Goal (Track impressions only)"]</option>
                <option value="1">@T["Button/Link Click"]</option>
                <option value="2">@T["Form Submission"]</option>
                <option value="3">@T["Scroll Percentage"]</option>
                <option value="4">@T["Custom Event"]</option>
            </select>
            <span asp-validation-for="GoalType" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="GoalDisplayName" class="form-label">@T["Goal Name (Optional)"]</label>
            <input asp-for="GoalDisplayName" class="form-control" placeholder="@T["e.g., Signup Button Click"]" />
            <div class="form-text">@T["A friendly name for this goal, shown in results."]</div>
        </div>
    </div>

    <div class="row mb-3" id="goalSelectorRow" style="display: none;">
        <div class="col-md-6">
            <label asp-for="GoalSelector" class="form-label">@T["CSS Selector"]</label>
            <input asp-for="GoalSelector" class="form-control" placeholder="@T["e.g., #signup-btn or .cta-button"]" />
            <span asp-validation-for="GoalSelector" class="text-danger"></span>
            <div class="form-text">@T["The CSS selector to identify the element(s) to track."]</div>
        </div>
    </div>

    <div class="row mb-3" id="goalScrollRow" style="display: none;">
        <div class="col-md-4">
            <label asp-for="GoalScrollPercentage" class="form-label">@T["Scroll Percentage"]</label>
            <div class="input-group">
                <input asp-for="GoalScrollPercentage" type="number" min="0" max="100" class="form-control" />
                <span class="input-group-text">%</span>
            </div>
            <span asp-validation-for="GoalScrollPercentage" class="text-danger"></span>
            <div class="form-text">@T["Track when user scrolls past this percentage of the page."]</div>
        </div>
    </div>

    <div class="row mb-3" id="goalEventRow" style="display: none;">
        <div class="col-md-6">
            <label asp-for="GoalEventName" class="form-label">@T["Event Name"]</label>
            <input asp-for="GoalEventName" class="form-control" placeholder="@T["e.g., purchase-completed"]" />
            <span asp-validation-for="GoalEventName" class="text-danger"></span>
            <div class="form-text">@T["The custom JavaScript event name to listen for. Trigger with: window.dispatchEvent(new Event('event-name'))"]</div>
        </div>
    </div>
</div>

<script at="Foot">
    (function() {
        // Traffic split slider
        var slider = document.getElementById('percentageSlider');
        var displayA = document.getElementById('percentageADisplay');
        var displayB = document.getElementById('percentageBDisplay');

        slider.addEventListener('input', function() {
            var valueA = parseInt(this.value);
            var valueB = 100 - valueA;
            displayA.textContent = valueA + '%';
            displayB.textContent = valueB + '%';
        });

        // Goal type field visibility
        var goalTypeSelect = document.getElementById('goalTypeSelect');
        var selectorRow = document.getElementById('goalSelectorRow');
        var scrollRow = document.getElementById('goalScrollRow');
        var eventRow = document.getElementById('goalEventRow');

        function updateGoalFields() {
            var value = parseInt(goalTypeSelect.value);
            // 1 = ButtonLinkClick, 2 = FormSubmission
            selectorRow.style.display = (value === 1 || value === 2) ? 'flex' : 'none';
            // 3 = ScrollPercentage
            scrollRow.style.display = (value === 3) ? 'flex' : 'none';
            // 4 = CustomEvent
            eventRow.style.display = (value === 4) ? 'flex' : 'none';
        }

        goalTypeSelect.addEventListener('change', updateGoalFields);
        updateGoalFields(); // Initialize on page load
    })();
</script>
