@model OrchardCore.ABTesting.ViewModels.ABTestingSettingsViewModel

<div class="mb-3">
    <div class="form-check">
        <input type="checkbox" class="form-check-input" asp-for="DisplayAllContentTypes" id="DisplayAllContentTypes">
        <label class="form-check-label" asp-for="DisplayAllContentTypes">@T["Allow all content types"]</label>
    </div>
    <span class="hint">@T["When checked, any content type can be used in A/B tests. When unchecked, only selected content types below can be used."]</span>
</div>

<div class="mb-3" id="ContentTypesContainer">
    <label class="form-label">@T["Allowed Content Types"]</label>
    <span class="hint d-block mb-2">@T["Select which content types can be used as variants in A/B tests."]</span>
    @await Component.InvokeAsync("SelectContentTypes", new {
        selectedContentTypes = Model.AllowedContentTypes,
        htmlName = Html.NameFor(m => m.AllowedContentTypes)
    })
</div>

<h5>@T["Statistical Analysis"]</h5>

<div class="mb-3">
    <label class="form-label" asp-for="MinimumSampleSizeLimit">@T["Minimum Sample Size Limit"]</label>
    <input type="number" class="form-control" asp-for="MinimumSampleSizeLimit" min="10" max="100" style="max-width: 150px;" />
    <span class="hint">@T["The minimum number of impressions per variant that can be configured for tests. Lower values allow faster results but less statistical reliability. (Range: 10-100, Default: 30)"]</span>
</div>

<h5>@T["Bot Detection"]</h5>

<div class="mb-3">
    <div class="form-check">
        <input type="checkbox" class="form-check-input" asp-for="EnableBotDetection" id="EnableBotDetection">
        <label class="form-check-label" asp-for="EnableBotDetection">@T["Enable bot detection"]</label>
    </div>
    <span class="hint">@T["When enabled, traffic from detected bots will not be recorded as impressions or conversions."]</span>
</div>

<div class="mb-3" id="BotPatternsContainer">
    <label class="form-label" asp-for="BotUserAgentPatternsText">@T["Bot User-Agent Patterns"]</label>
    <span class="hint d-block mb-2">@T["Enter one pattern per line. Patterns are matched case-insensitively against the User-Agent header."]</span>
    <textarea class="form-control font-monospace" asp-for="BotUserAgentPatternsText" rows="12"
              placeholder="@T["Enter bot patterns, one per line..."]"></textarea>
    <span class="hint">@T["Common patterns include: Googlebot, bingbot, spider, crawler, bot, etc."]</span>
</div>

<script at="Foot">
    document.addEventListener('DOMContentLoaded', function() {
        var displayAllCheckbox = document.getElementById('DisplayAllContentTypes');
        var contentTypesContainer = document.getElementById('ContentTypesContainer');

        function updateContentTypesVisibility() {
            if (displayAllCheckbox.checked) {
                contentTypesContainer.classList.add('d-none');
            } else {
                contentTypesContainer.classList.remove('d-none');
            }
        }

        displayAllCheckbox.addEventListener('change', updateContentTypesVisibility);
        updateContentTypesVisibility();

        var enableBotDetection = document.getElementById('EnableBotDetection');
        var botPatternsContainer = document.getElementById('BotPatternsContainer');

        function updateBotPatternsVisibility() {
            if (enableBotDetection.checked) {
                botPatternsContainer.classList.remove('d-none');
            } else {
                botPatternsContainer.classList.add('d-none');
            }
        }

        enableBotDetection.addEventListener('change', updateBotPatternsVisibility);
        updateBotPatternsVisibility();
    });
</script>
