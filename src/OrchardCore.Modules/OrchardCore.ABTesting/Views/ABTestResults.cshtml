@using OrchardCore.ABTesting.Models
@{
    string testName = Model.TestName;
    string testContentItemId = Model.TestContentItemId;
    int targetPercentageA = Model.TargetPercentageA;
    int targetPercentageB = Model.TargetPercentageB;
    bool isActive = Model.IsActive;
    string variantAName = Model.VariantAName;
    string variantAContentItemId = Model.VariantAContentItemId;
    long variantAImpressions = Model.VariantAImpressions;
    double variantAPercentage = Model.VariantAPercentage;
    string variantBName = Model.VariantBName;
    string variantBContentItemId = Model.VariantBContentItemId;
    long variantBImpressions = Model.VariantBImpressions;
    double variantBPercentage = Model.VariantBPercentage;
    long totalImpressions = Model.TotalImpressions;

    // Goal-related data
    GoalType goalType = Model.GoalType;
    string goalDisplayName = Model.GoalDisplayName;
    long variantAConversions = Model.VariantAConversions;
    long variantBConversions = Model.VariantBConversions;
    double variantAConversionRate = Model.VariantAConversionRate;
    double variantBConversionRate = Model.VariantBConversionRate;
    long totalConversions = Model.TotalConversions;
    bool hasGoal = goalType != GoalType.None;

    // Statistical analysis
    ABTestStatisticsResult statistics = Model.Statistics;
    bool isVariantAWinner = statistics?.WinningVariant == ABVariant.A;
    bool isVariantBWinner = statistics?.WinningVariant == ABVariant.B;
}

@if (hasGoal && statistics != null)
{
    @if (statistics.IsSignificant && statistics.WinningVariant.HasValue)
    {
        <div class="alert alert-success mb-4">
            <i class="fa-solid fa-trophy me-2" aria-hidden="true"></i>
            <strong>@statistics.SummaryText</strong>
        </div>
    }
    else if (!statistics.HasSufficientData)
    {
        <div class="alert alert-info mb-4">
            <i class="fa-solid fa-chart-line me-2" aria-hidden="true"></i>
            @statistics.SummaryText
        </div>
    }
    else
    {
        <div class="alert alert-secondary mb-4">
            <i class="fa-solid fa-scale-balanced me-2" aria-hidden="true"></i>
            @statistics.SummaryText
        </div>
    }
}

<div class="row mb-4">
    <div class="col-md-3">

            <div class="card">
<div class="card-header">
@T["Target Traffic Split"]
</div>

<div class="card-body">
    <p class="h4">@T["A: {0}% / B: {1}%", targetPercentageA, targetPercentageB]</p>
</div>

</div>

</div>

    <div class="col-md-3">

            <div class="card">
<div class="card-header">
@T["Total Impressions"]
</div>

<div class="card-body">
    <p class="h4">@totalImpressions.ToString("N0")</p>
</div>

</div>

</div>

    @if (hasGoal)
    {

    <div class="col-md-3">

            <div class="card">
<div class="card-header">
@T["Goal"]
</div>

<div class="card-body">
     <p class="h4">@goalDisplayName</p>
</div>

</div>

</div>

    <div class="col-md-3">

            <div class="card">
<div class="card-header">
@T["Total Conversions"]
</div>

<div class="card-body">
     <p class="h4">@totalConversions.ToString("N0")</p>
</div>

</div>

</div>

    }
</div>

@if (totalImpressions == 0)
{
    <div class="alert alert-info">
        @T["No impressions have been recorded yet. Impressions are tracked when visitors view pages that are part of this A/B test."]
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="card @(isVariantAWinner ? "border-success" : "border-primary") mb-3">
                <div class="card-header @(isVariantAWinner ? "bg-success" : "bg-primary") text-white d-flex justify-content-between align-items-center">
                    <strong>@T["Variant A"]</strong>
                    @if (isVariantAWinner)
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="fa-solid fa-trophy me-1" aria-hidden="true"></i>@T["Winner"]
                        </span>
                    }
                </div>
                <div class="card-body">
                    <p class="mb-1">
                        <strong>@variantAName</strong>
                        @if (!string.IsNullOrEmpty(variantAContentItemId))
                        {
                            <a asp-route-area="OrchardCore.Contents" asp-controller="Admin" asp-action="Edit" asp-route-contentItemId="@variantAContentItemId" class="ms-2 small">
                                <i class="fa-solid fa-edit" aria-hidden="true"></i> @T["Edit"]
                            </a>
                        }
                    </p>
                    <h3 class="mb-0">@variantAImpressions.ToString("N0")</h3>
                    <small class="text-muted">@T["impressions"]</small>
                    <div class="progress mt-3" style="height: 25px;">
                        <div class="progress-bar @(isVariantAWinner ? "bg-success" : "bg-primary")" role="progressbar" style="width: @variantAPercentage%;" aria-valuenow="@variantAPercentage" aria-valuemin="0" aria-valuemax="100">
                            @variantAPercentage%
                        </div>
                    </div>
                    <small class="text-muted">
                        @T["Actual: {0}% (Target: {1}%)", variantAPercentage, targetPercentageA]
                    </small>

                    @if (hasGoal)
                    {
                        <hr />
                        <h4 class="mb-0">@variantAConversions.ToString("N0")</h4>
                        <small class="text-muted">@T["conversions"]</small>
                        <div class="progress mt-2" style="height: 20px;">
                            <div class="progress-bar @(isVariantAWinner ? "bg-success" : "bg-warning")" role="progressbar" style="width: @(Math.Min(variantAConversionRate * 5, 100))%;" aria-valuenow="@variantAConversionRate" aria-valuemin="0" aria-valuemax="100">
                                @variantAConversionRate%
                            </div>
                        </div>
                        <small class="text-muted">
                            @T["Conversion Rate: {0}%", variantAConversionRate]
                        </small>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card @(isVariantBWinner ? "border-success" : "border-primary") mb-3">
                <div class="card-header @(isVariantBWinner ? "bg-success" : "bg-primary") text-white d-flex justify-content-between align-items-center">
                    <strong>@T["Variant B"]</strong>
                    @if (isVariantBWinner)
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="fa-solid fa-trophy me-1" aria-hidden="true"></i>@T["Winner"]
                        </span>
                    }
                </div>
                <div class="card-body">
                    <p class="mb-1">
                        <strong>@variantBName</strong>
                        @if (!string.IsNullOrEmpty(variantBContentItemId))
                        {
                            <a asp-route-area="OrchardCore.Contents" asp-controller="Admin" asp-action="Edit" asp-route-contentItemId="@variantBContentItemId" class="ms-2 small">
                                <i class="fa-solid fa-edit" aria-hidden="true"></i> @T["Edit"]
                            </a>
                        }
                    </p>
                    <h3 class="mb-0">@variantBImpressions.ToString("N0")</h3>
                    <small class="text-muted">@T["impressions"]</small>
                    <div class="progress mt-3" style="height: 25px;">
                        <div class="progress-bar @(isVariantBWinner ? "bg-success" : "bg-primary")" role="progressbar" style="width: @variantBPercentage%;" aria-valuenow="@variantBPercentage" aria-valuemin="0" aria-valuemax="100">
                            @variantBPercentage%
                        </div>
                    </div>
                    <small class="text-muted">
                        @T["Actual: {0}% (Target: {1}%)", variantBPercentage, targetPercentageB]
                    </small>

                    @if (hasGoal)
                    {
                        <hr />
                        <h4 class="mb-0">@variantBConversions.ToString("N0")</h4>
                        <small class="text-muted">@T["conversions"]</small>
                        <div class="progress mt-2" style="height: 20px;">
                            <div class="progress-bar @(isVariantBWinner ? "bg-success" : "bg-warning")" role="progressbar" style="width: @(Math.Min(variantBConversionRate * 5, 100))%;" aria-valuenow="@variantBConversionRate" aria-valuemin="0" aria-valuemax="100">
                                @variantBConversionRate%
                            </div>
                        </div>
                        <small class="text-muted">
                            @T["Conversion Rate: {0}%", variantBConversionRate]
                        </small>
                    }
                </div>
            </div>
        </div>
    </div>
}
