@model ABTestViewModel
@using System.Text.Json
@using OrchardCore.ContentFields.ViewModels
@{
    var searchUrl = Url.RouteUrl("ABTesting.SearchContentItems");
    var editUrl = Url.RouteUrl(new { area = "OrchardCore.Contents", controller = "Admin", action = "Edit", contentItemId = "contentItemId", returnUrl = FullRequestPath });
    var viewUrl = Url.RouteUrl(new { area = "OrchardCore.Contents", controller = "Admin", action = "Display", contentItemId = "contentItemId" });
    var variantAElementId = $"ContentPicker_VariantA_{Guid.NewGuid():N}";
    var variantBElementId = $"ContentPicker_VariantB_{Guid.NewGuid():N}";
    var selectedVariantA = Model.SelectedVariantA != null ? JConvert.SerializeObject(new[] { Model.SelectedVariantA }, JOptions.CamelCase) : "[]";
    var selectedVariantB = Model.SelectedVariantB != null ? JConvert.SerializeObject(new[] { Model.SelectedVariantB }, JOptions.CamelCase) : "[]";
}

<script asp-name="vue-multiselect-wrapper" at="Foot"></script>
<style asp-name="vue-multiselect" version="2" at="Foot"></style>

<zone Name="Title"><h1>@RenderTitleSegments(T["Edit A/B Test"])</h1></zone>

<form asp-action="Edit" asp-route-testId="@Model.TestId" method="post" class="no-multisubmit">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }

    <ul class="nav nav-tabs">
        <li class="nav-item pe-md-2">
            <a class="nav-link active" id="test-tab" data-bs-toggle="tab" href="#test" role="tab" aria-controls="test" aria-selected="true">@T["Test"]</a>
        </li>
        <li class="nav-item pe-md-2">
            <a class="nav-link" id="goal-tab" data-bs-toggle="tab" href="#goal" role="tab" aria-controls="goal">@T["Goal"]</a>
        </li>
        <li class="nav-item pe-md-2">
            <a class="nav-link" id="statistics-tab" data-bs-toggle="tab" href="#statistics" role="tab" aria-controls="statistics">@T["Settings"]</a>
        </li>
    </ul>

    <div class="tab-content" id="tabs">
        <!-- Test Tab -->
        <div class="tab-pane fade show active" id="test" role="tabpanel" aria-labelledby="test-tab">
            <div class="mb-3" asp-validation-class-for="Name">
                <label asp-for="Name" class="form-label">@T["Test Name"]</label>
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name" class="text-danger"></span>
                <div class="form-text">@T["A descriptive name for this A/B test."]</div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    @await DisplayAsync(await New.ABTestVariantPicker(
                        PropertyName: "VariantAContentItemId",
                        Label: "Variant A (Control)",
                        ElementId: variantAElementId,
                        SelectedItems: selectedVariantA,
                        SearchUrl: searchUrl,
                        EditUrl: editUrl,
                        ViewUrl: viewUrl,
                        HelpText: "Select the content item for the control variant."))
                </div>
                <div class="col-md-6">
                    @await DisplayAsync(await New.ABTestVariantPicker(
                        PropertyName: "VariantBContentItemId",
                        Label: "Variant B (Challenger)",
                        ElementId: variantBElementId,
                        SelectedItems: selectedVariantB,
                        SearchUrl: searchUrl,
                        EditUrl: editUrl,
                        ViewUrl: viewUrl,
                        HelpText: "Select the content item for the test variant."))
                </div>
            </div>

            @await DisplayAsync(await New.ABTestTrafficSplit(
                PercentageA: Model.PercentageA))
        </div>

        <!-- Goal Tab -->
        <div class="tab-pane fade" id="goal" role="tabpanel" aria-labelledby="goal-tab">
            @await DisplayAsync(await New.ABTestGoalConfiguration(
                GoalType: Model.GoalType,
                GoalSelector: Model.GoalSelector,
                GoalScrollPercentage: Model.GoalScrollPercentage,
                GoalEventName: Model.GoalEventName,
                GoalTimeOnPageSeconds: Model.GoalTimeOnPageSeconds,
                AreGoalsLocked: Model.AreGoalsLocked))
        </div>

        <!-- Settings Tab -->
        <div class="tab-pane fade" id="statistics" role="tabpanel" aria-labelledby="statistics-tab">
            @await DisplayAsync(await New.ABTestStatisticsConfiguration(
                MinimumSampleSize: Model.MinimumSampleSize,
                ConfidenceThreshold: Model.ConfidenceThreshold))
        </div>
    </div>

    <div class="mb-3">
        <button class="btn btn-primary save" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
