@model ABTestViewModel
@using System.Text.Json
@{
    var searchUrl = Url.RouteUrl("ABTesting.SearchContentItems");
    var editUrl = Url.RouteUrl(new { area = "OrchardCore.Contents", controller = "Admin", action = "Edit", contentItemId = "contentItemId", returnUrl = FullRequestPath });
    var viewUrl = Url.RouteUrl(new { area = "OrchardCore.Contents", controller = "Admin", action = "Display", contentItemId = "contentItemId" });
    var variantAElementId = $"ContentPicker_VariantA_{Guid.NewGuid():N}";
    var variantBElementId = $"ContentPicker_VariantB_{Guid.NewGuid():N}";
}

<script asp-name="vue-multiselect-wrapper" at="Foot"></script>
<style asp-name="vue-multiselect" version="2" at="Foot"></style>

<zone Name="Title"><h1>@RenderTitleSegments(T["Create A/B Test"])</h1></zone>

<div asp-validation-summary="ModelOnly"></div>

<form asp-action="Create" method="post" class="no-multisubmit">
    <div class="mb-3" asp-validation-class-for="Name">
        <label asp-for="Name" class="form-label">@T["Test Name"]</label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger"></span>
        <div class="form-text">@T["A descriptive name for this A/B test."]</div>
    </div>

    <h5 class="mt-4">@T["Variants"]</h5>
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3" asp-validation-class-for="VariantAContentItemId">
                <label asp-for="VariantAContentItemId" class="form-label">@T["Variant A Content"]</label>
                <div id="@variantAElementId" class="vue-multiselect" data-editor-type="ContentPicker" data-selected-items="[]" data-edit-url="@editUrl" data-view-url="@viewUrl" data-search-url="@searchUrl" data-multiple="false">
                    <ul class="mb-1 list-group content-picker-default__list" v-show="arrayOfItems.length" v-cloak>
                        <li v-for="(item, i) in arrayOfItems"
                            class="list-group-item content-picker-default__list-item d-flex align-items-start justify-content-between"
                            :key="item.id">
                            <div class="align-items-center align-self-center">
                                <a v-if="item.isClickable" :href="url(item)" target="_blank">
                                    <span>{{ item.displayText }}</span> <span v-show="!item.hasPublished" class="text-muted small">(@T["Not published"])</span>
                                </a>
                                <span v-else>
                                    <span>{{ item.displayText }}</span> <span v-show="!item.hasPublished" class="text-muted small">(@T["Not published"])</span>
                                </span>
                            </div>
                            <div class="btn-group btn-group-sm align-items-center" role="group">
                                <button v-on:click="remove(item)" type="button" class="btn btn-secondary content-picker-default__list-item__delete"><i class="fa-solid fa-trash fa-sm" aria-hidden="true"></i></button>
                            </div>
                        </li>
                    </ul>
                    <div>
                        <input asp-for="VariantAContentItemId" type="hidden" v-model="selectedIds" />
                        <vue-multiselect v-model="value" :options="options" track-by="id"
                                         label="displayText" placeholder="@T["Type to search for content..."]"
                                         @@search-change="asyncFind" @@select="onSelect"
                                         :searchable="true" :close-on-select="true" :reset-after="true"
                                         :show-labels="true" :hide-selected="false"
                                         :disabled="isDisabled"
                                         select-label="@T["Select"]" deselect-label="@T["Remove"]">
                            <template slot="option" slot-scope="props">
                                <div v-cloak><span>{{ props.option.displayText }}</span><span class="small ms-2" v-show="!props.option.hasPublished">(@T["Not published"])</span></div>
                            </template>
                            <template slot="noResult">
                                @T["No result found"]
                            </template>
                        </vue-multiselect>
                    </div>
                </div>
                <span asp-validation-for="VariantAContentItemId" class="text-danger"></span>
                <div class="form-text">@T["Select the content item for the control variant."]</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3" asp-validation-class-for="VariantBContentItemId">
                <label asp-for="VariantBContentItemId" class="form-label">@T["Variant B Content"]</label>
                <div id="@variantBElementId" class="vue-multiselect" data-editor-type="ContentPicker" data-selected-items="[]" data-edit-url="@editUrl" data-view-url="@viewUrl" data-search-url="@searchUrl" data-multiple="false">
                    <ul class="mb-1 list-group content-picker-default__list" v-show="arrayOfItems.length" v-cloak>
                        <li v-for="(item, i) in arrayOfItems"
                            class="list-group-item content-picker-default__list-item d-flex align-items-start justify-content-between"
                            :key="item.id">
                            <div class="align-items-center align-self-center">
                                <a v-if="item.isClickable" :href="url(item)" target="_blank">
                                    <span>{{ item.displayText }}</span> <span v-show="!item.hasPublished" class="text-muted small">(@T["Not published"])</span>
                                </a>
                                <span v-else>
                                    <span>{{ item.displayText }}</span> <span v-show="!item.hasPublished" class="text-muted small">(@T["Not published"])</span>
                                </span>
                            </div>
                            <div class="btn-group btn-group-sm align-items-center" role="group">
                                <button v-on:click="remove(item)" type="button" class="btn btn-secondary content-picker-default__list-item__delete"><i class="fa-solid fa-trash fa-sm" aria-hidden="true"></i></button>
                            </div>
                        </li>
                    </ul>
                    <div>
                        <input asp-for="VariantBContentItemId" type="hidden" v-model="selectedIds" />
                        <vue-multiselect v-model="value" :options="options" track-by="id"
                                         label="displayText" placeholder="@T["Type to search for content..."]"
                                         @@search-change="asyncFind" @@select="onSelect"
                                         :searchable="true" :close-on-select="true" :reset-after="true"
                                         :show-labels="true" :hide-selected="false"
                                         :disabled="isDisabled"
                                         select-label="@T["Select"]" deselect-label="@T["Remove"]">
                            <template slot="option" slot-scope="props">
                                <div v-cloak><span>{{ props.option.displayText }}</span><span class="small ms-2" v-show="!props.option.hasPublished">(@T["Not published"])</span></div>
                            </template>
                            <template slot="noResult">
                                @T["No result found"]
                            </template>
                        </vue-multiselect>
                    </div>
                </div>
                <span asp-validation-for="VariantBContentItemId" class="text-danger"></span>
                <div class="form-text">@T["Select the content item for the test variant."]</div>
            </div>
        </div>
    </div>

    <h5 class="mt-4">@T["Traffic Split"]</h5>
    <div class="row align-items-center">
        <div class="col-md-8">
            <label asp-for="PercentageA" class="form-label">@T["Variant A Percentage"]</label>
            <input asp-for="PercentageA" type="range" class="form-range" min="0" max="100" id="percentageSlider" />
            <span asp-validation-for="PercentageA" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <div class="d-flex justify-content-around">
                <div class="text-center">
                    <strong>@T["Variant A"]</strong>
                    <div class="fs-4 text-primary" id="percentageADisplay">@Model.PercentageA%</div>
                </div>
                <div class="text-center">
                    <strong>@T["Variant B"]</strong>
                    <div class="fs-4 text-secondary" id="percentageBDisplay">@Model.PercentageB%</div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-text">@T["Drag the slider to adjust the traffic split between variants."]</div>

    <h5 class="mt-4">@T["Goal Configuration"]</h5>
    <div class="mb-3 w-50">
        <label asp-for="GoalType" class="form-label">@T["Goal Type"]</label>
        <select asp-for="GoalType" class="form-select" id="goalTypeSelect">
            <option value="0">@T["No Goal (Track impressions only)"]</option>
            <option value="1">@T["Button/Link Click"]</option>
            <option value="2">@T["Form Submission"]</option>
            <option value="3">@T["Scroll Percentage"]</option>
            <option value="4">@T["Custom Event"]</option>
        </select>
        <span asp-validation-for="GoalType" class="text-danger"></span>
    </div>

    <div class="mb-3 w-50" id="goalSelectorRow" style="display: none;">
        <label asp-for="GoalSelector" class="form-label">@T["CSS Selector"]</label>
        <input asp-for="GoalSelector" class="form-control" placeholder="@T["e.g., #signup-btn or .cta-button"]" />
        <span asp-validation-for="GoalSelector" class="text-danger"></span>
        <div class="form-text">@T["The CSS selector to identify the element(s) to track."]</div>
    </div>

    <div class="mb-3 w-50" id="goalScrollRow" style="display: none;">
        <label asp-for="GoalScrollPercentage" class="form-label">@T["Scroll Percentage"]</label>
        <div class="input-group" style="max-width: 200px;">
            <input asp-for="GoalScrollPercentage" type="number" min="0" max="100" class="form-control" />
            <span class="input-group-text">%</span>
        </div>
        <span asp-validation-for="GoalScrollPercentage" class="text-danger"></span>
        <div class="form-text">@T["Track when user scrolls past this percentage of the page."]</div>
    </div>

    <div class="mb-3 w-50" id="goalEventRow" style="display: none;">
        <label asp-for="GoalEventName" class="form-label">@T["Event Name"]</label>
        <input asp-for="GoalEventName" class="form-control" placeholder="@T["e.g., purchase-completed"]" />
        <span asp-validation-for="GoalEventName" class="text-danger"></span>
        <div class="form-text">@T["The custom JavaScript event name to listen for. Trigger with: window.dispatchEvent(new Event('event-name'))"]</div>
    </div>

    <h5 class="mt-4">@T["Statistics Configuration"]</h5>
    <div class="mb-3">
        <label asp-for="MinimumSampleSize" class="form-label">@T["Minimum Sample Size"]</label>
        <input asp-for="MinimumSampleSize" type="number" min="30" max="500" class="form-control" style="max-width: 200px;" />
        <span asp-validation-for="MinimumSampleSize" class="text-danger"></span>
        <div class="form-text">@T["Minimum impressions per variant required before statistical analysis. Lower values give faster results but less reliable statistics. (Range: 30-500, Default: 50)"]</div>
    </div>

    <div class="mb-3">
        <label asp-for="ConfidenceThreshold" class="form-label">@T["Confidence Threshold"]</label>
        <select asp-for="ConfidenceThreshold" class="form-select" style="max-width: 200px;">
            <option value="90">@T["90% (Faster results)"]</option>
            <option value="95">@T["95% (Standard)"]</option>
            <option value="99">@T["99% (Most reliable)"]</option>
        </select>
        <span asp-validation-for="ConfidenceThreshold" class="text-danger"></span>
        <div class="form-text">@T["The confidence level required to declare a winning variant. Higher values require more evidence before declaring a winner."]</div>
    </div>

    <div class="mb-3">
        <button class="btn btn-primary create" type="submit">@T["Create"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>

<script at="Foot">
    (function() {
        // Traffic split slider
        var slider = document.getElementById('percentageSlider');
        var displayA = document.getElementById('percentageADisplay');
        var displayB = document.getElementById('percentageBDisplay');

        slider.addEventListener('input', function() {
            var valueA = parseInt(this.value);
            var valueB = 100 - valueA;
            displayA.textContent = valueA + '%';
            displayB.textContent = valueB + '%';
        });

        // Goal type visibility
        var goalTypeSelect = document.getElementById('goalTypeSelect');
        var selectorRow = document.getElementById('goalSelectorRow');
        var scrollRow = document.getElementById('goalScrollRow');
        var eventRow = document.getElementById('goalEventRow');

        function updateGoalFields() {
            var value = parseInt(goalTypeSelect.value);
            // 1 = ButtonLinkClick, 2 = FormSubmission
            selectorRow.style.display = (value === 1 || value === 2) ? 'block' : 'none';
            // 3 = ScrollPercentage
            scrollRow.style.display = (value === 3) ? 'block' : 'none';
            // 4 = CustomEvent
            eventRow.style.display = (value === 4) ? 'block' : 'none';
        }

        goalTypeSelect.addEventListener('change', updateGoalFields);
        updateGoalFields();
    })();
</script>
<script at="Foot" depends-on="vue-multiselect-wrapper">
    initVueMultiselect(document.querySelector("#@variantAElementId"));
    initVueMultiselect(document.querySelector("#@variantBElementId"));
</script>
