@model ABTestIndexViewModel

<zone Name="Title"><h1>@RenderTitleSegments(T["A/B Tests"])</h1></zone>

@* the form is necessary to generate an antiforgery token for the delete, activate, and deactivate actions *@
<form asp-action="Index" method="post" class="no-multisubmit">
    <div class="card mb-3 text-bg-theme position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-3">
                <div class="col">
                    <div class="has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus />
                    </div>
                </div>
                <div class="col-auto">
                    <a asp-action="Create" class="btn btn-secondary create" role="button">@T["Add A/B Test"]</a>
                </div>
            </div>
        </div>
    </div>

    <ul class="list-group" id="abtest-list">
        @if (Model.Tests.Any())
        {
            @foreach (var entry in Model.Tests)
            {
                var deleteMessage = T["Are you sure you want to delete this A/B test?"];
                <li class="list-group-item list-group-item-action" data-filter-value="@entry.Name.ToLowerInvariant()">
                    <div class="row">
                        <div class="col-lg col-12 d-flex align-items-center">
                            <div class="summary d-flex flex-column flex-md-row flex-wrap">
                                <div class="me-2">
                                    @if (entry.HasDeletedVariant || entry.IsConcluded)
                                    {
                                        <a asp-action="Results" asp-route-testId="@entry.TestId">@entry.Name</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Edit" asp-route-testId="@entry.TestId">@entry.Name</a>
                                    }
                                </div>
                                <div class="me-2">
                                    @if (entry.IsConcluded)
                                    {
                                        <span class="badge ta-badge" data-bs-toggle="tooltip" title="@T["This test has concluded. The winning variant has been selected."]">
                                            <i class="fa-solid fa-trophy text-success" aria-hidden="true"></i> @T["Concluded - {0} Won", entry.WinningVariantDisplayName]
                                        </span>
                                    }
                                    else if (entry.HasDeletedVariant)
                                    {
                                        <span class="badge ta-badge" data-bs-toggle="tooltip" title="@T["One or more variants have been deleted. This test cannot be reactivated."]">
                                            <i class="fa-solid fa-exclamation-triangle text-danger" aria-hidden="true"></i> @T["Read-only"]
                                        </span>
                                    }
                                    else if (entry.HasUnavailableVariant)
                                    {
                                        <span class="badge ta-badge" data-bs-toggle="tooltip" title="@T["One or more variants are unpublished. Publish them to activate this test."]">
                                            <i class="fa-solid fa-exclamation-triangle text-warning" aria-hidden="true"></i> @T["Variant Unpublished"]
                                        </span>
                                    }
                                    else if (entry.IsActive)
                                    {
                                        <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Status"]">
                                            <i class="fa-solid fa-check text-success" aria-hidden="true"></i> @T["Active"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Status"]">
                                            <i class="fa-solid fa-pause text-secondary" aria-hidden="true"></i> @T["Inactive"]
                                        </span>
                                    }
                                </div>
                                <div class="me-2">
                                    <span class="badge ta-badge font-weight-normal" title="@T["Impressions"]"  data-bs-toggle="tooltip" title="@T["Impressions"]">
                                        <i class="fa-solid fa-eye text-secondary" aria-hidden="true"></i> @entry.TotalImpressions
                                    </span>
                                </div>
                                <div class="me-2">
                                    <span class="badge ta-badge font-weight-normal" title="@T["Conversions"]" data-bs-toggle="tooltip" title="@T["Conversions"]">
                                        <i class="fa-solid fa-bullseye text-secondary" aria-hidden="true"></i> @entry.TotalConversions
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-auto col-12 d-flex justify-content-end">
                            <div class="actions d-flex gap-1">
                                <a class="btn btn-sm btn-info" asp-action="Results" asp-route-testId="@entry.TestId" role="button">
                                    <i class="fa-solid fa-chart-bar" aria-hidden="true"></i> @T["Results"]
                                </a>

                                @if (!entry.HasDeletedVariant && !entry.IsConcluded)
                                {
                                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-testId="@entry.TestId" role="button">@T["Edit"]</a>
                                }

                                @if (entry.IsActive)
                                {
                                    <a class="btn btn-sm btn-warning" asp-action="Deactivate" asp-route-testId="@entry.TestId" role="button" data-url-af="UnsafeUrl">@T["Deactivate"]</a>
                                }
                                else if (!entry.HasDeletedVariant && !entry.IsConcluded)
                                {
                                    @if (entry.HasUnavailableVariant)
                                    {
                                        <span class="btn btn-sm btn-success disabled" data-bs-toggle="tooltip" title="@T["Cannot activate - variant unpublished"]">@T["Activate"]</span>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-success" asp-action="Activate" asp-route-testId="@entry.TestId" role="button" data-url-af="UnsafeUrl">@T["Activate"]</a>
                                    }
                                }
                                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-testId="@entry.TestId" role="button" data-url-af="UnsafeUrl RemoveUrl" data-title="@T["Delete A/B Test"]" data-message="@deleteMessage" data-ok-text="@T["Ok"]" data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
                            </div>
                        </div>
                    </div>
                </li>
            }
        }
        else
        {
            <li class="list-group-item">
                <div class="alert alert-info mb-0" role="alert">
                    @T["<strong>Nothing here!</strong> There are no A/B tests yet. Click 'Add A/B Test' to create your first test."]
                </div>
            </li>
        }
    </ul>
    <div id="list-alert" class="alert alert-info d-none" role="alert">
        @T["<strong>Nothing here!</strong> Your search returned no results."]
    </div>
</form>

<script at="Foot">
    $(function () {
        var searchBox = $('#search-box');
        var list = $('#abtest-list');

        searchBox.keyup(function (e) {
            var search = $(this).val().toLowerCase();
            var elementsToFilter = list.find("[data-filter-value]");

            if (e.key === "Escape" || search == '') {
                searchBox.val('');
                elementsToFilter.removeClass("d-none");
                $('#list-alert').addClass("d-none");
            }
            else {
                var visibleCount = 0;
                elementsToFilter.each(function () {
                    var text = $(this).data('filter-value').toLowerCase();
                    var found = text.indexOf(search) > -1;

                    if (found) {
                        $(this).removeClass("d-none");
                        visibleCount++;
                    }
                    else {
                        $(this).addClass("d-none");
                    }
                });

                if (visibleCount == 0) {
                    $('#list-alert').removeClass("d-none");
                }
                else {
                    $('#list-alert').addClass("d-none");
                }
            }
        });
    });
</script>
