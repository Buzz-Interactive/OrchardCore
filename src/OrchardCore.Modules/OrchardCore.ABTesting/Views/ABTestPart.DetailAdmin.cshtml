@model ABTestPartViewModel

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">
            @T["A/B Test Configuration"]
            @if (Model.IsActive)
            {
                <span class="badge bg-success ms-2">@T["Active"]</span>
            }
            else
            {
                <span class="badge bg-secondary ms-2">@T["Inactive"]</span>
            }
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h6>@T["Variant A"]</h6>
                <p class="mb-1">@Model.VariantADisplayText</p>
                <div class="progress" style="height: 25px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.PercentageA%;"
                         aria-valuenow="@Model.PercentageA" aria-valuemin="0" aria-valuemax="100">
                        @Model.PercentageA%
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <h6>@T["Variant B"]</h6>
                <p class="mb-1">@Model.VariantBDisplayText</p>
                <div class="progress" style="height: 25px;">
                    <div class="progress-bar bg-secondary" role="progressbar" style="width: @Model.PercentageB%;"
                         aria-valuenow="@Model.PercentageB" aria-valuemin="0" aria-valuemax="100">
                        @Model.PercentageB%
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
