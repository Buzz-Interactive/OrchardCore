@using OrchardCore.ABTesting.ViewModels
@model ABTestingSettingsViewModel

<h3>@T["A/B Testing Settings"]</h3>
<p class="text-muted">@T["Configure statistical analysis settings for A/B test results."]</p>

<div class="mb-3" asp-validation-class-for="MinimumSampleSize">
    <label asp-for="MinimumSampleSize" class="form-label">@T["Minimum Sample Size"]</label>
    <input asp-for="MinimumSampleSize" type="number" min="30" max="500" class="form-control" style="max-width: 200px;" />
    <span asp-validation-for="MinimumSampleSize" class="text-danger"></span>
    <span class="hint">@T["Minimum impressions per variant required before statistical analysis. Lower values give faster results but less reliable statistics. (Range: 30-500, Default: 50)"]</span>
</div>

<div class="mb-3" asp-validation-class-for="ConfidenceThreshold">
    <label asp-for="ConfidenceThreshold" class="form-label">@T["Confidence Threshold"]</label>
    <select asp-for="ConfidenceThreshold" class="form-select" style="max-width: 200px;">
        <option value="90">@T["90% (Faster results)"]</option>
        <option value="95">@T["95% (Standard)"]</option>
        <option value="99">@T["99% (Most reliable)"]</option>
    </select>
    <span asp-validation-for="ConfidenceThreshold" class="text-danger"></span>
    <span class="hint">@T["The confidence level required to declare a winning variant. Higher values require more evidence before declaring a winner."]</span>
</div>
