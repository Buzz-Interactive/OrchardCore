{% if Model.ContentItem.Content.Items.ContentItems.size > 0 %}
<!-- Clients -->
<div class="py-5">
    <div class="container">
        <div class="row align-items-center">
            {% for client in Model.ContentItem.Content.Items.ContentItems %}
            <div class="col-md-3 col-sm-6 my-3">
                <a href="{{ client.Client.Url.Text }}" aria-label="{{ client.DisplayText }}">
                    <img class="img-fluid img-brand d-block mx-auto" src="{{ client.Client.Logo.Paths.first | asset_url }}" alt="">
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}
