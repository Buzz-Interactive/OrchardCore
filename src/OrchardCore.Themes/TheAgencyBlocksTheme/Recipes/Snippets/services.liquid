{% if Model.ContentItem.Content.Items.ContentItems.size > 0 %}
<!-- Services -->
<section class="page-section" id="services">
    <div class="container">
        <div class="text-center">
            <h2 class="section-heading text-uppercase">{{ Model.ContentItem | display_text }}</h2>
            <h3 class="section-subheading text-muted">{{ Model.ContentItem.Content.Services.Subheading.Text }}</h3>
        </div>
        <div class="row text-center">
            {% for service in Model.ContentItem.Content.Items.ContentItems %}
            <div class="col-md-4">
                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas {{ service.Service.IconClass.Text }} fa-stack-1x fa-inverse"></i>
                </span>
                <h4 class="service-heading">{{ service.DisplayText }}</h4>
                <p class="text-muted">{{ service.HtmlBodyPart.Html | raw }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
